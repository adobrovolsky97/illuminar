{
    "name": "adobrovolsky97/illuminar",
    "description": "Debug tool for Laravel Framework",
    "keywords": [
        "laravel",
        "debugger",
        "profiler",
        "debug"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Andrew Dobrovolsky",
            "email": "adobrovolsky97@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Adobrovolsky97\\Illuminar\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Adobrovolsky97\\Illuminar\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "laravel/framework": "^10.15|^11.0|^12.0|^13.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.2",
        "orchestra/testbench": "^8.21|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Adobrovolsky97\\Illuminar\\ServiceProvider"
            ],
            "aliases": {
                "Illuminar": "Adobrovolsky97\\Illuminar\\Facades\\Illuminar"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
